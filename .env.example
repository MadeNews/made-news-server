# ════════════════════════════════════════════════════════════════════════════
#  MadeNews Server: environment template
#  Copy to .env and fill in the secrets:   cp .env.example .env
#  Then run natively with:                 npm install && node server.js
#  The server listens on http://localhost:3000.
#  Lines left empty fall back to the defaults shown in the comments.
# ════════════════════════════════════════════════════════════════════════════


# ════════════════════════════ SECRETS ═══════════════════════════════════════
# Never commit .env or paste these values anywhere public.

# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# Clients must send this value in the "x-api-key" header for every route
# except /, /story/random and /verify/:token. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_API_KEY=

# Secret used to sign email verification tokens (JWT). Long random string.
JWT_SECRET=

# Firebase service account key, as ONE line of JSON with no surrounding quotes.
#   1. Firebase Console > Project settings > Service accounts > Generate new private key
#   2. Convert the downloaded file to one line:
#        node -e "console.log(JSON.stringify(require('./service-account.json')))"
#   3. Paste the output after the = sign.
# The service account needs the IAM roles "Firebase Admin SDK Administrator
# Service Agent" and "Service Account Token Creator" (Google Cloud Console > IAM).
GCP_SERVICE_KEY=

# SMTP login used to send verification emails (for Gmail, use an App Password).
EMAIL_USER=
EMAIL_PASSWORD=


# ════════════════════════════ CONFIG ════════════════════════════════════════

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL of this server, used in verification email links.
# Natively hosted:  http://your-host:3000   (or your domain behind a reverse proxy)
SERVER_URL=http://localhost:3000

# Nodemailer service name, e.g. gmail, outlook, yahoo
EMAIL_SERVICE=gmail

# ─── Groq: endpoint & models ─────────────────────────────────────────────────
# Models: https://console.groq.com/docs/models
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# Model for one-off stories (/api/generate, /api/generate/random, /story/random)
GROQ_MODEL=openai/gpt-oss-120b
# Model for the weekly batch (empty = same as GROQ_MODEL)
WEEKLY_GROQ_MODEL=openai/gpt-oss-120b

# ─── Groq: reasoning ─────────────────────────────────────────────────────────
# low | medium | high for reasoning models (gpt-oss).
# Set "off" for models that reject reasoning params (e.g. llama-3.3-70b-versatile).
GROQ_REASONING_EFFORT=low
# Per-mode overrides (empty = GROQ_REASONING_EFFORT). Reasoning tokens count
# toward the *_MAX_TOKENS caps below, so higher effort needs a higher cap.
STORY_REASONING_EFFORT=medium
CHARACTER_REASONING_EFFORT=medium
WEEKLY_REASONING_EFFORT=low
# Ask Groq not to return the reasoning text (it is never used).
GROQ_HIDE_REASONING=true

# ─── Groq: plan limits & request handling ────────────────────────────────────
# Your plan's tokens-per-minute limit: https://console.groq.com/settings/limits
# The free tier is 8000. The weekly output budget is derived from this number.
GROQ_TPM_LIMIT=8000
# Headroom kept under the limit, and the characters-per-token estimate.
GROQ_TOKEN_SAFETY_MARGIN=350
GROQ_CHARS_PER_TOKEN=3.5
# HTTP timeout for Groq calls (ms), and the longest wait before retrying a 429 (s).
GROQ_REQUEST_TIMEOUT_MS=120000
GROQ_RETRY_MAX_WAIT_SECONDS=65

# ─── Generation: sampling & length ───────────────────────────────────────────
GROQ_TOP_P=0.9
# News mode (no satireStyle): a news article narrated by a random character
STORY_TEMPERATURE=0.85
STORY_MAX_TOKENS=3000
# Character mode (satireStyle=<persona id>): a monologue by that character
# Higher = wilder voice; lower (e.g. 0.85) if stories drift off topic.
CHARACTER_TEMPERATURE=0.95
CHARACTER_MAX_TOKENS=3000
# Weekly batch
WEEKLY_TEMPERATURE=0.85
# Optional extra cap on weekly output (empty = GROQ_TPM_LIMIT - prompt - margin)
WEEKLY_MAX_TOKENS=

# ─── Weekly feed ─────────────────────────────────────────────────────────────
# Articles per category (5 categories in categories.json). With 2 per category,
# the whole feed fits one request on the free tier; paragraphs get shorter at 3+.
# Trigger the refresh with: GET /cron/refreshWeekly (with the x-api-key header)
ARTICLES_PER_CATEGORY=2
